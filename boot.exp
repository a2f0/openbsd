#!/usr/bin/expect -f

# Usage: ./boot.exp          boot the VM and attach to its console
#        ./boot.exp --check  boot the VM, verify console and ssh logins, then
#                            power it off (requires USER_PASSWORD)
#        ./boot.exp --check-hardened  also apply and verify the native baseline
#                                    (requires ROOT_PASSWORD and SSH_IDENTITY_FILE)
#        ./boot.exp --verify-hardened verify persistence after a reboot

set VM_RUNNING 0
set known_hosts_file ""
set archive_file ""
set VERIFY_ONLY 0

proc shutdown_vm {} {
    global VM_RUNNING spawn_id
    if {!$VM_RUNNING} {
        return
    }
    # A failed check must still let the guest flush its filesystems. Clear
    # the normal failure handlers so cleanup cannot recursively call exit.
    expect_after
    send -- "\u0001c"
    expect {
        -timeout 5
        "(qemu)" {}
        eof { set VM_RUNNING 0; return }
        timeout { error "Timed out opening the QEMU monitor" }
    }
    send "system_powerdown\r"
    expect {
        -timeout 120
        eof {}
        timeout {
            send "quit\r"
            expect -timeout 10 eof
            set VM_RUNNING 0
            error "VM did not shut down within 120 seconds"
        }
    }
    set VM_RUNNING 0
}

exit -onexit {
    catch {shutdown_vm}
    if {$::known_hosts_file ne ""} {
        file delete -force $::known_hosts_file
    }
    if {$::archive_file ne ""} {
        file delete -force $::archive_file
    }
}

set HARDEN 0
if {$argc == 0} {
    set CHECK 0
} elseif {$argc == 1 && [lindex $argv 0] in {--check --check-hardened --verify-hardened}} {
    set CHECK 1
    set HARDEN [expr {[lindex $argv 0] ne "--check"}]
    set VERIFY_ONLY [expr {[lindex $argv 0] eq "--verify-hardened"}]
} else {
    puts "Usage: $argv0 \[--check|--check-hardened|--verify-hardened\]"
    exit 1
}

if {$HARDEN} {
    foreach required_var {ROOT_PASSWORD SSH_IDENTITY_FILE} {
        if {![info exists env($required_var)] || $env($required_var) eq ""} {
            puts "Error: $required_var must be set for --check-hardened."
            exit 1
        }
    }
}

if {$CHECK && ![info exists env(USER_PASSWORD)]} {
    puts "Error: USER_PASSWORD must be set for --check."
    exit 1
}

puts "Starting OpenBSD VM with SSH access..."

# Check if the VM disk image exists
if {![file exists "openbsd-vm.qcow2"]} {
    puts "Error: openbsd-vm.qcow2 not found. Please run the installation script first."
    exit 1
}

puts "Booting OpenBSD VM with SSH on port 2222..."

spawn qemu-system-x86_64 \
    -m 4096 \
    -smp cpus=2 \
    -nographic \
    -serial mon:stdio \
    -hda openbsd-vm.qcow2 \
    -net nic,model=e1000 \
    -net user,hostfwd=tcp:127.0.0.1:2222-:22 \
    -boot c
set VM_RUNNING 1

# Fail if any expect below times out or QEMU exits, instead of carrying on
expect_after {
    timeout { puts "\nError: timed out waiting for VM output"; exit 1 }
    eof     { puts "\nError: QEMU exited unexpectedly"; exit 1 }
}

# Wait for the VM to boot and show login prompt
expect -timeout 300 "login: "

if {$CHECK} {
    # Log in on the console and wait for a shell prompt
    send "a2f0\r"
    expect "Password:"
    send -- "$env(USER_PASSWORD)\r"
    expect {
        "Login incorrect" { puts "\nError: console login failed"; exit 1 }
        -re {\$ $} {}
    }
    send "uname -sr\r"
    expect -re {OpenBSD [0-9]+\.[0-9]+}
    expect -re {\$ $}

    # Trust the SSH host key obtained from the VM console, rather than
    # disabling host key verification for the smoke test.
    send "cat /etc/ssh/ssh_host_ed25519_key.pub\r"
    expect -re {\r\n(ssh-ed25519 [A-Za-z0-9+/=]+)[ \r\n]}
    set host_key $expect_out(1,string)
    expect -re {\$ $}
    set known_hosts_file [exec mktemp]
    set known_hosts [open $known_hosts_file w]
    puts $known_hosts "\[127.0.0.1\]:2222 $host_key"
    close $known_hosts

    # Log in over ssh with the user's installed key. SSH_IDENTITY_FILE picks
    # the private key (CI uses a throwaway one), otherwise ssh's defaults apply.
    set ssh_cmd [list ssh -p 2222 -o BatchMode=yes -o ConnectTimeout=10 \
        -o PreferredAuthentications=publickey -o PasswordAuthentication=no \
        -o KbdInteractiveAuthentication=no -o ControlMaster=no -S none \
        -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$known_hosts_file \
        -o LogLevel=ERROR]
    if {[info exists env(SSH_IDENTITY_FILE)] && $env(SSH_IDENTITY_FILE) ne ""} {
        lappend ssh_cmd -i $env(SSH_IDENTITY_FILE) -o IdentitiesOnly=yes
    }
    lappend ssh_cmd a2f0@127.0.0.1
    if {
        [catch {exec {*}$ssh_cmd uname -sr 2>@1} ssh_out] ||
        ![string match "OpenBSD *" $ssh_out]
    } {
        puts "\nError: ssh login as a2f0 failed: $ssh_out"
        exit 1
    }
    puts "\nssh login as a2f0 succeeded: $ssh_out"

    if {$HARDEN} {
        set archive_file [exec mktemp]
        if {
            [catch {
                exec tar -cf $archive_file baseline tests
                exec {*}$ssh_cmd tar -xpf - -C /home/a2f0 < $archive_file 2>@1
            } transfer_out]
        } {
            puts "\nError: baseline transfer failed: $transfer_out"
            exit 1
        }
        # Use the root console on the disposable VM. No remote interpreter,
        # package bootstrap, password SSH login, or new doas rule is needed.
        send "su -\r"
        expect "Password:"
        send -- "$env(ROOT_PASSWORD)\r"
        expect {
            "Sorry" { puts "\nError: root console login failed"; exit 1 }
            -re {# $} {}
        }
        if {$VERIFY_ONLY} {
            set command "/bin/sh /home/a2f0/baseline/baseline.sh verify \
                --ssh-context user=a2f0,host=10.0.2.2,addr=10.0.2.2,laddr=10.0.2.15,lport=22"
        } else {
            set command "/bin/sh /home/a2f0/tests/on-host.sh"
        }
        send -- "$command; printf '\\n__BASELINE_STATUS__:%s\\n' \"\$?\"\r"
        expect -timeout 180 -re {\r\n__BASELINE_STATUS__:([0-9]+)\r\n}
        if {$expect_out(1,string) ne "0"} {
            puts "\nError: native baseline checks failed"
            exit 1
        }
        expect -re {# $}
        if {[catch {exec {*}$ssh_cmd uname -sr 2>@1} ssh_out]} {
            puts "\nError: SSH login failed after hardening: $ssh_out"
            exit 1
        }
        puts "\nNative hardening and fresh SSH checks passed"
    }

    shutdown_vm

    puts "\nCheck passed"
    exit 0
}

interact
