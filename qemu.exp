#!/usr/bin/expect -f

set INSTALL_CONF_CREATED 0

foreach required_var {USER_PASSWORD ROOT_PASSWORD} {
    if {![info exists env($required_var)] || $env($required_var) eq ""} {
        puts "Error: $required_var must be set."
        exit 1
    }
    if {[regexp {[\r\n]} $env($required_var)]} {
        puts "Error: $required_var must not contain newlines."
        exit 1
    }
}

# Function to generate install.conf with environment variable interpolation
proc generate_install_conf {} {
    set user_password $::env(USER_PASSWORD)
    set root_password $::env(ROOT_PASSWORD)
    # SSH_PUBLIC_KEY replaces the default key for the user (CI passes a throwaway key)
    # tclint-disable-next-line line-length -- Keep the existing public key intact.
    set ssh_public_key "ssh-rsa  dansullivan@gmail.com"
    if {[info exists ::env(SSH_PUBLIC_KEY)] && $::env(SSH_PUBLIC_KEY) ne ""} {
        set ssh_public_key $::env(SSH_PUBLIC_KEY)
    }
    # Generate install.conf
    set conf_content "System hostname = openbsd-vm
Password for root = $root_password
Do you expect to run the X Window System = no
Change the default console to com0 = yes
Which speed should com0 use = 19200
Setup a user = a2f0
Password for user = $user_password
Public ssh key for user = $ssh_public_key
What timezone are you in = UTC
Location of sets = cd0
HTTP Server = cdn.openbsd.org
Disk to use = sd0
Partitioning = auto
# Directory does not contain SHA256.sig. Continue without verification?
Continue without verification? = yes
Set name(s) = -game* -x* -comp*"

    # Write the content to install.conf
    set file [open "install.conf" {WRONLY CREAT TRUNC} 0600]
    set ::INSTALL_CONF_CREATED 1
    file attributes "install.conf" -permissions 0600
    puts $file $conf_content
    close $file

    puts "Generated install.conf with interpolated passwords"
}

set WEB_SERVER_PID ""
set WEB_SERVER_SPAWN_ID ""

proc cleanup {} {
    global WEB_SERVER_PID WEB_SERVER_SPAWN_ID INSTALL_CONF_CREATED
    puts "Cleaning up..."
    if {$WEB_SERVER_PID != ""} {
        puts "Stopping Python web server (PID: $WEB_SERVER_PID)..."
        catch {exec kill $WEB_SERVER_PID}
        catch {close -i $WEB_SERVER_SPAWN_ID}
        catch {wait -i $WEB_SERVER_SPAWN_ID}
    }
    if {$INSTALL_CONF_CREATED} {
        file delete -force "install.conf"
    }
}

# Always run cleanup on exit. The handler must not call exit itself, or the
# script's exit status is replaced with 0.
exit -onexit cleanup

puts "Starting Python web server on port 8686..."
set python_executable [exec uv run --locked python -c {import sys; print(sys.executable)}]
spawn -noecho $python_executable -u -m http.server 8686 --bind 127.0.0.1
set WEB_SERVER_PID [exp_pid]
set WEB_SERVER_SPAWN_ID $spawn_id

# Read readiness from this child after it binds, rather than accepting any
# service that happens to be listening on the installation port.
expect {
    -timeout 10
    -re {Serving HTTP on 127\.0\.0\.1 port 8686} {}
    eof { puts "Error: installation web server exited before binding port 8686."; exit 1 }
    timeout { puts "Error: installation web server did not start within 10 seconds."; exit 1 }
}
puts "Web server is now listening on port 8686"

# Function to download file with error handling
proc download_file {url filename} {
    puts "Attempting to download $filename from $url"

    # Try wget
    set wget_result [catch {exec wget -q -O $filename $url} wget_output]
    if {$wget_result == 0} {
        puts "Download completed successfully using wget"
        return 1
    }

    puts "wget failed: $wget_output"
    puts "Please install wget or download manually."
    return 0
}

set OPENBSD_VERSION "7.9"
set OPENBSD_PERIOD_STRIPPED [regsub -all {\.} $OPENBSD_VERSION ""]
set ISO_FILE "install$OPENBSD_PERIOD_STRIPPED.iso"
set SHA256_FILE "SHA256"
set DISK_FILE "openbsd-vm.qcow2"

if {![file exists $SHA256_FILE]} {
    puts "ISO file not found: $SHA256_FILE"
    set download_url "https://cdn.openbsd.org/pub/OpenBSD/$OPENBSD_VERSION/amd64/SHA256"

    if {[download_file $download_url $SHA256_FILE]} {
        puts "Download completed: $SHA256_FILE"
    } else {
        puts "Failed to download SHA256 file."
        cleanup
        exit 1
    }
} else {
    puts "SHA256 file already exists: $SHA256_FILE"
}

if {![file exists $ISO_FILE]} {
    puts "ISO file not found: $ISO_FILE"
    set download_url "https://cdn.openbsd.org/pub/OpenBSD/$OPENBSD_VERSION/amd64/$ISO_FILE"

    if {[download_file $download_url $ISO_FILE]} {
        puts "Download completed: $ISO_FILE"
    } else {
        puts "Failed to download ISO file."
        cleanup
        exit 1
    }
} else {
    puts "ISO file already exists: $ISO_FILE"
}

# Verify SHA256 checksums
puts "Verifying SHA256 checksums..."
set checksum_command [auto_execok sha256sum]
if {$checksum_command eq ""} {
    set checksum_command [auto_execok gsha256sum]
}
if {$checksum_command eq ""} {
    puts "Error: install GNU coreutils for sha256sum or gsha256sum."
    exit 1
}
set sha256_result [catch {exec {*}$checksum_command -c SHA256 --ignore-missing} sha256_output]
if {$sha256_result != 0} {
    puts "Error: SHA256 verification failed: $sha256_output"
    cleanup
    exit 1
}
puts "SHA256 verification completed successfully"

if {[file exists $DISK_FILE]} {
    puts "Error: Virtual disk '$DISK_FILE' already exists."
    cleanup
    exit 1
}

generate_install_conf

puts "Creating virtual disk image..."
exec qemu-img create -f qcow2 $DISK_FILE 5G

puts "Starting QEMU with host access through 10.0.2.2"

spawn qemu-system-x86_64 \
    -m 4096 \
    -smp cpus=2 \
    -nographic \
    -cdrom $ISO_FILE \
    -hda $DISK_FILE \
    -boot c

# Fail if any expect below times out or QEMU exits, instead of carrying on
expect_after {
    timeout { puts "\nError: timed out waiting for VM output"; exit 1 }
    eof     { puts "\nError: QEMU exited unexpectedly"; exit 1 }
}

expect "boot>"
send "set tty com0\r"
expect "boot>"
send "boot\r"
expect -timeout 60 "(I)nstall, (U)pgrade, (A)utoinstall or (S)hell?"
send "A\r"
expect "Response file location?"
send "http://10.0.2.2:8686/install.conf\r"
expect -timeout 600 "login: "

# Enter the qemu menu by pressing cntrl+a, then c
# cntrl + a
send "\x01"
sleep 0.1
send "c"

expect "(qemu)"

# qemu command to shut down the vm
send "system_powerdown\r"

puts "Waiting for vm to stop..."

# Drain the console until QEMU exits before reaping the child process.
expect -timeout 120 eof
wait

puts "\rFinished"
